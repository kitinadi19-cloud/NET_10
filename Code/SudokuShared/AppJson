using System.Text.Json;
using System.Text.Json.Serialization;

namespace SudokuServer
{
    /// cấu hình JSON dùng chung cho module lưu trữ và khán giả
    /// Enum được ghi dạng chuỗi (ví dụ:"Player1Win") để file lịch sử dễ đọc và client dễ xử lý
    public static class AppJson
    {
        public static readonly JsonSerializerOptions Options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            Converters = { new JsonStringEnumConverter() }
        };

        public static readonly JsonSerializerOptions Pretty = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            WriteIndented = true,
            Converters = { new JsonStringEnumConverter() }
        };
    }
}
